# Tavily AI
TAVILY_API_KEY=tvly-YOUR_API_KEY_HERE

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here         # sb_publishable_... — para uso client-side
SUPABASE_SERVICE_KEY=your-service-role-key   # sb_secret_...     — para uploads server-side

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-token-here
INSTAGRAM_USER_ID=your-instagram-user-id

# YouTube Data API
YOUTUBE_REFRESH_TOKEN=your-refresh-token-here
YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret

# Upstash Redis (BullMQ — ioredis/TCP format)
UPSTASH_REDIS_HOST=your-redis.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-redis-password-here
UPSTASH_REDIS_TLS=true
